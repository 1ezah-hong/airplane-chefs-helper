{
  "name": "chc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx src/db/migrate.ts",
    "db:migrate:test": "NODE_OPTIONS=--conditions=react-server DATABASE_URL=$TEST_DATABASE_URL tsx src/db/migrate.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx src/db/seed/seed.ts",
    "data:build-new-york": "tsx src/db/seed/build-new-york-data.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "xlsx": "^0.18.5"
  }
}
